# Copy to .env and fill in. Never commit .env.
# TrueForge API (local standalone mode)
TRUEFORGE_URL=http://localhost:8790
# Fine-grained GitHub PAT scoped to vishnuverse/humanize only
# (Contents, Issues, Pull requests: read/write). Used by the orchestrator
# (labels), scripts/check.py (reads) and scripts/reset.sh.
GITHUB_PAT=
# TypeSafe Jev, for the Triage agent after P0
TYPESAFE_API_KEY=
