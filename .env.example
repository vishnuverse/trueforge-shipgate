# Copy to .env and fill in. Never commit .env.
# TrueForge API (local standalone mode)
TRUEFORGE_URL=http://localhost:8790
# Fine-grained GitHub PAT scoped to the repo named in shipgate.yaml (target.repo)
# only (Contents, Issues, Pull requests: read/write). scripts/setup.sh registers
# it as the "github" connector in TrueForge; also read by the orchestrator
# (labels), scripts/check.py (reads) and scripts/reset.sh (demo fork only).
GITHUB_PAT=
# OpenRouter key for the agent's model (shipgate.yaml trueforge.model).
# scripts/setup.sh registers it as the "openrouter" model provider in TrueForge.
OPENROUTER_API_KEY=
# TypeSafe Jev key for the Triage pre-check. Read on the host only, by
# mcp/triage/server.py; never sent to TrueForge or the sandbox.
TYPESAFE_API_KEY=
