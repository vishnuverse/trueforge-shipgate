# Copy to .env and fill in. Never commit .env.
# Optional override, normally left commented out: the TrueForge URL comes from
# shipgate.yaml (trueforge.url). An environment TRUEFORGE_URL wins over it
# (setup.sh reads it from the environment only, not from this file).
# TRUEFORGE_URL=http://localhost:8790
# Fine-grained GitHub PAT scoped to the repo named in shipgate.yaml (target.repo)
# only (Contents, Issues, Pull requests: read/write). scripts/setup.sh registers
# it as the "github" connector in TrueForge; also read by the orchestrator
# (labels), scripts/check.py (reads) and scripts/reset.sh (demo fork only).
GITHUB_PAT=
# Model key for shipgate.yaml trueforge.model; scripts/setup.sh requires only the one its prefix names.
# openai/...: registered as the "openai" model provider in TrueForge (the default, openai/gpt-6-luna).
OPENAI_API_KEY=
# openrouter/...: registered as the "openrouter" model provider (the earlier deepseek-v4-flash setup).
OPENROUTER_API_KEY=
# TypeSafe Jev key for the Triage pre-check. Read on the host only, by
# mcp/triage/server.py; never sent to TrueForge or the sandbox.
TYPESAFE_API_KEY=
# Jira (only when shipgate.yaml has a jira: section): the Atlassian account email
# and an API token of that account (REST Basic auth). Required by scripts/setup.sh
# then; read on the host by mcp/triage/server.py and scripts/seed_jira.py.
JIRA_EMAIL=
JIRA_API_KEY=
