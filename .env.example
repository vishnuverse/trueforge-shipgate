# Copy to .env and fill in. Never commit .env.
# Optional override, normally left commented out: the TrueForge URL comes from
# shipgate.yaml (trueforge.url). An environment TRUEFORGE_URL wins over it
# (setup.sh reads it from the environment only, not from this file).
# TRUEFORGE_URL=http://localhost:8790
# Fine-grained GitHub PAT scoped to the repo named in shipgate.yaml (target.repo)
# only (Contents, Issues, Pull requests: read/write). scripts/setup.sh registers
# it as the "github" connector in TrueForge; also read by the orchestrator
# (labels), scripts/check.py (reads) and scripts/reset.sh (demo fork only).
GITHUB_PAT=
# Model key for shipgate.yaml trueforge.model; scripts/setup.sh requires only the one its prefix names.
# openrouter/...: registered as the "openrouter" model provider in TrueForge (the default,
# openrouter/deepseek-v4-flash).
OPENROUTER_API_KEY=
# openai/...: registered as the "openai" model provider (only if you set trueforge.model: openai/gpt-6-luna).
OPENAI_API_KEY=
# TypeSafe Jev key for the Triage pre-check. Read on the host only, by
# mcp/triage/server.py; never sent to TrueForge or the sandbox.
TYPESAFE_API_KEY=
# Jira (only when shipgate.yaml has a jira: section): the Atlassian account
# email and an API token for that account (create it at id.atlassian.com,
# Security > API tokens). scripts/setup.sh registers them as the "jira"
# connector in TrueForge (Basic auth header); also read by the triage MCP
# (reads the ticket), the orchestrator (moves the ticket's status) and
# scripts/check.py (reads). Never sent to the sandbox.
# If your Atlassian org blocks API-token MCP access, connect the jira server with
# OAuth in the TrueForge UI; these keys are still needed for REST.
JIRA_EMAIL=
JIRA_API_KEY=
